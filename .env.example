# Copy this file to .env (local) or set these in Hostinger's Node.js "Environment variables" screen.
# Never commit real values.

NODE_ENV=production
PORT=3000
DEMO_MODE=false
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters-long

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Contact form emails. Leave SMTP_* empty and the form still saves messages to the database,
# but nobody is emailed.
CONTACT_TO=dsmaservicesbps@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dsmaservicesbps@gmail.com
# For Gmail this is a 16-character "App password", NOT the normal Gmail password.
SMTP_PASS=
# Optional: SMTP_SECURE=true|false (defaults to true for port 465), SMTP_FROM=address to send from

# First start only: creates the first DSMA team login if none exists. Delete TEAM_PASSWORD afterwards.
TEAM_EMAIL=
TEAM_PASSWORD=
TEAM_NAME=DSMA Team
